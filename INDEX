    <!-- JAVASCRIPT LOGIC -->
    <script>
        /* ==========================================================================
           1. INITIAL STATE & MOCK DATA
           ========================================================================== */
        let isArtistMode = false;
        let activeCategory = 'all';
        let currentModalArtIndex = 0;

        // Sample Artworks
        let artworks = [
            {
                id: 'art-1',
