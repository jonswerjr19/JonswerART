                    { author: 'Diego G.', text: 'Mi tatuaje favorito del estudio, curó perfectamente.', date: 'Hace 1 semana' }
                ]
            },
            {
                id: 'art-5',
                title: 'Noche en el Valle de Jade',
                category: 'Pinturas',
                medium: 'Técnica Mixta sobre Lienzo',
                image: 'https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=1000&q=80',
                description: 'Paisaje expresionista con pinceladas cargadas y relieve táctil con espátula.',
                likes: 19,
                userLiked: false,
                comments: []
            },
            {
                id: 'art-6',
                title: 'Furia Mitológica',
                category: 'Tatuajes',
                medium: 'Custom Full Sleeve Tattoo',
                image: 'https://images.unsplash.com/photo-1562962230-16e4623d36e6?auto=format&fit=crop&w=1000&q=80',
                description: 'Manga completa basada en la mitología nórdica formulada a medida tras 4 sesiones de trabajo.',
                likes: 53,
                userLiked: false,
                comments: []
            }
        ];

        // Sample Consultations / Client Chat Requests
        let consultations = [
            {
                id: 'comm-101',
                clientName: 'Sonia Restrepo',
                artType: 'Retratos',
                description: 'Quisiera un retrato al óleo de mis abuelos a partir de una fotografía en blanco y negro antigua.',
                image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80',
                status: 'En Proceso',
                timestamp: 'Hoy, 10:30 AM',
                chat: [
                    { sender: 'client', author: 'Sonia Restrepo', text: 'Hola maestro! Adjunté la foto de referencia. ¿Sería posible restaurar los tonos de luz al óleo?', time: '10:30 AM' },
                    { sender: 'artist', author: 'Artista (Taller)', text: '¡Hola Sonia! Excelente fotografía. Sí, podemos enriquecer la paleta con tonos sepia cálidos y detalles al óleo. ¿Qué dimensiones tienes pensadas?', time: '11:15 AM' }
                ]
            },
            {
                id: 'comm-102',
                clientName: 'Andrés Castro',
                artType: 'Tatuajes',
                description: 'Idea para cover-up en la espalda con diseño de fénix surrealista.',
                image: 'https://images.unsplash.com/photo-1550537687-c91072c4792d?auto=format&fit=crop&w=600&q=80',
                status: 'Pendiente',
                timestamp: 'Ayer, 4:15 PM',
                chat: [
                    { sender: 'client', author: 'Andrés Castro', text: 'Me gustaría saber cuántas sesiones requeriríamos para adaptar esta idea a la espalda.', time: '4:15 PM' }
                ]
            }
        ];

        let selectedCommId = consultations[0].id;
        let tempCommissionImageBase64 = '';
        let tempUploadImageBase64 = '';

        /* ==========================================================================
           2. DOM RENDER & GALLERY LOGIC
           ========================================================================== */
        window.onload = function() {
            renderGallery();
            renderConsultationsList();
            renderActiveChat();
            updateStats();
        };

        function updateStats() {
            document.getElementById('stat-total-art').innerText = artworks.length;
            const totalLikes = artworks.reduce((acc, curr) => acc + curr.likes, 0);
            document.getElementById('stat-total-likes').innerText = totalLikes;
            document.getElementById('stat-commissions').innerText = consultations.length;
            document.getElementById('comm-count-badge').innerText = `${consultations.length} solicitudes`;
        }

        function filterGallery(category) {
            activeCategory = category;
            
            // Update filter button styles
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.getAttribute('data-cat') === category) {
                    btn.className = "cat-btn active px-5 py-2.5 rounded-xl text-xs font-bold tracking-wider uppercase transition-all whitespace-nowrap bg-amber-500 text-gray-950 shadow-lg shadow-amber-500/20";
                } else {
                    btn.className = "cat-btn px-5 py-2.5 rounded-xl text-xs font-bold tracking-wider uppercase transition-all whitespace-nowrap bg-artCard text-gray-300 hover:text-white border border-gray-800 hover:border-amber-500/50";
                }
            });

            renderGallery();
        }

        function renderGallery() {
            const grid = document.getElementById('gallery-grid');
            const emptyState = document.getElementById('gallery-empty');
            grid.innerHTML = '';

            const filtered = activeCategory === 'all' 
                ? artworks 
                : artworks.filter(item => item.category === activeCategory);

            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            filtered.forEach((art) => {
                const globalIndex = artworks.findIndex(a => a.id === art.id);
                const card = document.createElement('div');
                card.className = "group glass-panel rounded-3xl overflow-hidden border border-artBorder hover:border-cyan-400/50 transition-all duration-500 flex flex-col justify-between hover:-translate-y-1 shadow-xl";
                
                card.innerHTML = `
                    <div class="relative overflow-hidden cursor-pointer h-72" onclick="openArtworkModal(${globalIndex})">
                        <img src="${art.image}" alt="${art.title}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" onerror="this.src='https://placehold.co/600x400/11182c/00f0ff?text=Obra+de+Arte'">
                        <div class="absolute inset-0 bg-gradient-to-t from-artCard via-transparent to-transparent opacity-80 group-hover:opacity-40 transition-opacity"></div>
                        
                        <!-- Category Badge -->
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-artDark/80 backdrop-blur-md border border-cyan-500/30 text-cyan-300 text-[10px] font-bold uppercase tracking-wider">
                            ${art.category}
                        </span>

                        <!-- Zoom overlay icon -->
                        <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 backdrop-blur-[2px]">
                            <span class="w-12 h-12 rounded-full bg-cyan-400 text-gray-950 flex items-center justify-center text-lg font-bold shadow-lg shadow-cyan-400/30">
                                <i class="fa-solid fa-expand"></i>
                            </span>
                        </div>
                    </div>

                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <h3 class="font-serif text-xl font-bold text-white group-hover:text-cyan-400 transition-colors line-clamp-1">${art.title}</h3>
                            <p class="text-xs text-cyan-400/90 font-medium mt-1 mb-2">${art.medium}</p>
                            <p class="text-xs text-gray-400 line-clamp-2 leading-relaxed mb-4">${art.description}</p>
                        </div>

                        <div class="pt-4 border-t border-artBorder flex items-center justify-between">
                            <!-- Like Button -->
                            <button onclick="toggleGalleryLike('${art.id}', event)" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full ${art.userLiked ? 'bg-pink-500 text-white' : 'bg-artDark hover:bg-pink-500/20 text-pink-400 border border-pink-500/20'} transition-all text-xs font-bold">
                                <i class="fa-solid fa-heart ${art.userLiked ? 'animate-bounce' : ''}"></i>
                                <span>${art.likes}</span>
                            </button>

                            <div class="flex items-center gap-3">
                                <button onclick="openArtworkModal(${globalIndex})" class="text-xs text-gray-400 hover:text-white flex items-center gap-1 transition-colors">
                                    <i class="fa-solid fa-comment text-purple-400"></i> ${art.comments.length}
                                </button>
                                <a href="#comisiones" onclick="preselectCommissionType('${art.category}')" class="text-xs font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
                                    Encargar <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function toggleGalleryLike(artId, event) {
            if(event) event.stopPropagation();
            const art = artworks.find(a => a.id === artId);
            if (!art) return;

            if (art.userLiked) {
                art.likes--;
                art.userLiked = false;
                showToast("Se eliminó de tus favoritas", "info");
            } else {
                art.likes++;
                art.userLiked = true;
                showToast("¡Añadido a tus obras favoritas!", "success");
            }

            renderGallery();
            updateStats();

            // If modal is currently showing this art, update modal counters
            if (artworks[currentModalArtIndex]?.id === artId) {
                updateModalLikeUI();
            }
        }

        /* ==========================================================================
           3. LIGHTBOX MODAL & COMMENTS LOGIC
           ========================================================================== */
        function openArtworkModal(index) {
            currentModalArtIndex = index;
            const art = artworks[index];
            if (!art) return;

            document.getElementById('modal-art-image').src = art.image;
            document.getElementById('modal-art-title').innerText = art.title;
            document.getElementById('modal-art-category').innerText = art.category;
            document.getElementById('modal-art-medium').innerText = art.medium;
            document.getElementById('modal-art-desc').innerText = art.description;

            updateModalLikeUI();
            renderModalComments();

            document.getElementById('artwork-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeArtworkModal() {
            document.getElementById('artwork-modal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function navigateGallery(direction) {
            currentModalArtIndex += direction;
            if (currentModalArtIndex < 0) currentModalArtIndex = artworks.length - 1;
            if (currentModalArtIndex >= artworks.length) currentModalArtIndex = 0;
            openArtworkModal(currentModalArtIndex);
        }

        function updateModalLikeUI() {
            const art = artworks[currentModalArtIndex];
            const btn = document.getElementById('modal-art-like-btn');
            const count = document.getElementById('modal-art-like-count');

            count.innerText = art.likes;
            if (art.userLiked) {
                btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-rose-500 text-white transition-all text-xs font-bold shadow-lg shadow-rose-500/30";
            } else {
                btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 hover:bg-rose-500 hover:text-white transition-all text-xs font-bold";
            }
        }

        function toggleModalLike() {
            const art = artworks[currentModalArtIndex];
            toggleGalleryLike(art.id, null);
        }

        function renderModalComments() {
            const art = artworks[currentModalArtIndex];
            const list = document.getElementById('modal-comments-list');
            list.innerHTML = '';

            if (art.comments.length === 0) {
                list.innerHTML = `<p class="text-xs text-gray-500 italic py-2">Aún no hay comentarios. ¡Sé el primero en opinar sobre esta creación!</p>`;
                return;
            }

            art.comments.forEach(c => {
                const item = document.createElement('div');
                item.className = "p-3 rounded-xl bg-artDark/80 border border-gray-800 text-xs space-y-1";
                item.innerHTML = `
                    <div class="flex items-center justify-between text-amber-400 font-semibold">
                        <span><i class="fa-solid fa-circle-user mr-1 text-gray-400"></i>${escapeHtml(c.author)}</span>
                        <span class="text-[10px] text-gray-500 font-normal">${c.date || 'Reciente'}</span>
                    </div>
                    <p class="text-gray-300 leading-normal">${escapeHtml(c.text)}</p>
                `;
                list.appendChild(item);
            });
        }

        function handleAddArtworkComment(e) {
            e.preventDefault();
            const author = document.getElementById('comment-author').value.trim();
            const text = document.getElementById('comment-text').value.trim();

            if (!author || !text) return;

            const art = artworks[currentModalArtIndex];
            art.comments.push({
                author: author,
                text: text,
                date: 'Ahora'
            });

            document.getElementById('comment-text').value = '';
            renderModalComments();
            renderGallery();
            showToast("Comentario publicado exitosamente", "success");
        }

        /* ==========================================================================
           4. CLIENT CONSULTATIONS & CHAT LOGIC
           ========================================================================== */
        function preselectCommissionType(cat) {
            const select = document.getElementById('client-type');
            select.value = cat;
        }

        function previewCommissionImage(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    tempCommissionImageBase64 = event.target.result;
                    document.getElementById('comm-preview-img').src = tempCommissionImageBase64;
                    document.getElementById('commission-upload-prompt').classList.add('hidden');
                    document.getElementById('commission-image-preview').classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        function handleCommissionSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('client-name').value.trim();
            const type = document.getElementById('client-type').value;
            const desc = document.getElementById('client-msg').value.trim();

            const imgUrl = tempCommissionImageBase64 || 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=600&q=80';

            const newComm = {
                id: 'comm-' + Date.now(),
                clientName: name,
                artType: type,
                description: desc,
                image: imgUrl,
                status: 'Pendiente',
                timestamp: 'Justo Ahora',
                chat: [
                    { sender: 'client', author: name, text: desc, time: 'Ahora' }
                ]
            };

            consultations.unshift(newComm);
            selectedCommId = newComm.id;

            // Reset form
            document.getElementById('commission-form').reset();
            document.getElementById('commission-upload-prompt').classList.remove('hidden');
            document.getElementById('commission-image-preview').classList.add('hidden');
            tempCommissionImageBase64 = '';

            renderConsultationsList();
            renderActiveChat();
            updateStats();
            showToast("¡Consulta y propuesta enviada! Revisa el chat interactivo.", "success");
        }

        function renderConsultationsList() {
            const container = document.getElementById('consultation-list');
            container.innerHTML = '';

            consultations.forEach(comm => {
                const isActive = comm.id === selectedCommId;
                const card = document.createElement('div');
                card.onclick = () => {
                    selectedCommId = comm.id;
                    renderConsultationsList();
                    renderActiveChat();
                };

                card.className = `p-3 rounded-2xl cursor-pointer transition-all border ${
                    isActive 
                    ? 'bg-amber-500/10 border-amber-500/50 text-white' 
                    : 'bg-artDark/50 border-gray-800/80 hover:bg-artDark text-gray-300'
                }`;

                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <img src="${comm.image}" class="w-11 h-11 rounded-xl object-cover border border-gray-700">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between">
                                <h4 class="text-xs font-bold text-white truncate">${escapeHtml(comm.clientName)}</h4>
                                <span class="text-[9px] text-amber-400 font-semibold">${comm.artType}</span>
                            </div>
                            <p class="text-[11px] text-gray-400 truncate mt-0.5">${escapeHtml(comm.description)}</p>
                        </div>
                    </div>
                `;

                container.appendChild(card);
            });
        }

        function renderActiveChat() {
            const activeArea = document.getElementById('chat-active-area');
            const comm = consultations.find(c => c.id === selectedCommId);

            if (!comm) {
                activeArea.innerHTML = `<p class="text-xs text-gray-500 text-center my-auto">Selecciona una consulta para abrir la sala de chat.</p>`;
                return;
            }

            let chatHtml = `
                <!-- Chat Header -->
                <div class="pb-3 border-b border-artBorder flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <img src="${comm.image}" class="w-10 h-10 rounded-xl object-cover border border-cyan-500/30">
                        <div>
                            <h4 class="text-sm font-bold text-white">${escapeHtml(comm.clientName)}</h4>
                            <p class="text-[10px] text-gray-400">Idea para: <span class="text-cyan-400 font-semibold">${comm.artType}</span></p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                        comm.status === 'En Proceso' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' : 'bg-purple-500/20 text-purple-300 border border-purple-500/30'
                    }">
                        ${comm.status}
                    </span>
                </div>

                <!-- Reference Image Preview Toggle -->
                <div class="my-2 p-2 rounded-xl bg-black/40 border border-artBorder flex items-center justify-between text-xs">
                    <span class="text-gray-400 text-[11px]"><i class="fa-solid fa-image text-cyan-400 mr-1.5"></i>Foto de Referencia</span>
                    <a href="${comm.image}" target="_blank" class="text-cyan-400 hover:underline text-[11px] font-semibold">Ver Completa <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i></a>
                </div>

                <!-- Messages Thread -->
                <div class="flex-1 overflow-y-auto custom-scrollbar my-2 space-y-3 pr-1 max-h-[300px]">
            `;

            comm.chat.forEach(msg => {
                const isArtist = msg.sender === 'artist';
                chatHtml += `
                    <div class="flex flex-col ${isArtist ? 'items-end' : 'items-start'}">
                        <span class="text-[9px] text-gray-500 mb-0.5 px-1">${escapeHtml(msg.author)} • ${msg.time}</span>
                        <div class="max-w-[85%] p-3 rounded-2xl text-xs leading-relaxed ${
                            isArtist 
                            ? 'bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 text-gray-950 font-semibold rounded-tr-none shadow-lg shadow-cyan-500/10' 
                            : 'bg-artCard border border-artBorder text-gray-200 rounded-tl-none'
                        }">
                            ${escapeHtml(msg.text)}
                        </div>
                    </div>
                `;
            });

            chatHtml += `
                </div>

                <!-- Reply Input -->
                <form onsubmit="handleSendChatMessage(event, '${comm.id}')" class="pt-2 border-t border-artBorder flex items-center gap-2">
                    <input type="text" id="chat-input-${comm.id}" placeholder="${isArtistMode ? 'Responder como el Artista...' : 'Escribe una respuesta a tu propuesta...'}" required class="flex-1 bg-artCard border border-artBorder rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-400">
                    <button type="submit" class="px-4 py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-gray-950 font-bold text-xs shadow-md shadow-cyan-400/20">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            `;

            activeArea.innerHTML = chatHtml;
        }

        function handleSendChatMessage(e, commId) {
            e.preventDefault();
            const input = document.getElementById(`chat-input-${commId}`);
            const text = input.value.trim();
            if (!text) return;

            const comm = consultations.find(c => c.id === commId);
            if (!comm) return;

            const senderType = isArtistMode ? 'artist' : 'client';
            const authorName = isArtistMode ? 'Artista (Taller)' : comm.clientName;

            comm.chat.push({
                sender: senderType,
                author: authorName,
                text: text,
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            });

            if (isArtistMode && comm.status === 'Pendiente') {
                comm.status = 'En Proceso';
            }

            input.value = '';
            renderActiveChat();
            renderConsultationsList();
            showToast("Mensaje enviado en el chat", "success");
        }

        /* ==========================================================================
           5. ARTIST MODE & AUTHENTICATION
           ========================================================================== */
        function toggleArtistModeModal() {
            if (isArtistMode) {
                // Logout from artist mode
                isArtistMode = false;
                updateArtistModeUI();
                showToast("Modo Artista desactivado", "info");
            } else {
                document.getElementById('artist-pin-modal').classList.remove('hidden');
            }
        }

        function closeArtistPinModal() {
            document.getElementById('artist-pin-modal').classList.add('hidden');
        }

        function handleArtistAuth(e) {
            e.preventDefault();
            const pin = document.getElementById('artist-pin-input').value;
            if (pin === 'Claro2022*/') { // Updated password requirement
                isArtistMode = true;
                updateArtistModeUI();
                closeArtistPinModal();
                document.getElementById('artist-pin-input').value = '';
                showToast("¡Modo Artista activado con éxito!", "success");
            } else {
                showToast("Clave incorrecta. Por favor verifica tu contraseña.", "error");
            }
        }

        function updateArtistModeUI() {
            const btnText = document.getElementById('artist-status-text');
            const btnIcon = document.getElementById('artist-status-icon');
            const btn = document.getElementById('artist-mode-btn');

            if (isArtistMode) {
                btnText.innerText = "Artista Activo";
                btnIcon.className = "fa-solid fa-user-check text-sm";
                btn.className = "relative group px-4 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2 border border-emerald-500 bg-emerald-500/20 text-emerald-300 shadow-lg shadow-emerald-500/20";
            } else {
                btnText.innerText = "Modo Artista";
                btnIcon.className = "fa-solid fa-lock text-sm";
                btn.className = "relative group px-4 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2 border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 hover:bg-cyan-400 hover:text-gray-950 shadow-lg shadow-cyan-500/10";
            }

            renderActiveChat();
        }

        /* ==========================================================================
           6. NEW ARTWORK UPLOAD LOGIC
           ========================================================================== */
        function openUploadModal() {
            if (!isArtistMode) {
                showToast("Por favor autentícate en 'Modo Artista' para subir nuevas obras.", "info");
                toggleArtistModeModal();
                return;
            }
            document.getElementById('upload-modal').classList.remove('hidden');
        }

        function closeUploadModal() {
            document.getElementById('upload-modal').classList.add('hidden');
        }

        function previewUploadImage(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    tempUploadImageBase64 = event.target.result;
                    document.getElementById('upload-preview-img').src = tempUploadImageBase64;
                    document.getElementById('upload-preview-box').classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        function previewUploadUrl(url) {
            if (url) {
                tempUploadImageBase64 = url;
                document.getElementById('upload-preview-img').src = url;
                document.getElementById('upload-preview-box').classList.remove('hidden');
            }
        }

        function handleUploadArtworkSubmit(e) {
            e.preventDefault();
            const title = document.getElementById('upload-title').value.trim();
            const category = document.getElementById('upload-category').value;
            const medium = document.getElementById('upload-medium').value.trim();
            const desc = document.getElementById('upload-desc').value.trim();

            const imageSrc = tempUploadImageBase64 || 'https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=1000&q=80';

            const newArt = {
                id: 'art-' + Date.now(),
                title: title,
                category: category,
                medium: medium,
                image: imageSrc,
                description: desc,
                likes: 0,
                userLiked: false,
                comments: []
            };

            artworks.unshift(newArt);

            // Reset form
            document.getElementById('upload-title').value = '';
            document.getElementById('upload-medium').value = '';
            document.getElementById('upload-desc').value = '';
            document.getElementById('upload-url').value = '';
            document.getElementById('upload-preview-box').classList.add('hidden');
            tempUploadImageBase64 = '';

            closeUploadModal();
            filterGallery('all');
            updateStats();
            showToast("¡Nueva obra añadida exitosamente a la galería!", "success");
        }

        /* ==========================================================================
           7. UTILITIES & TOASTS
           ========================================================================== */
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function showToast(message, type = "info") {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let bgClass = "bg-artCard border-cyan-500/50 text-cyan-300";
            let icon = "fa-circle-info";

            if (type === "success") {
                bgClass = "bg-artCard border-emerald-500/50 text-emerald-300";
                icon = "fa-circle-check";
            } else if (type === "error") {
                bgClass = "bg-artCard border-pink-500/50 text-pink-300";
                icon = "fa-triangle-exclamation";
            }

            toast.className = `glass-panel border px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 text-xs font-semibold transform transition-all duration-300 translate-x-10 opacity-0 ${bgClass}`;
            toast.innerHTML = `<i class="fa-solid ${icon} text-base"></i> <span>${escapeHtml(message)}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-x-10', 'opacity-0');
            }, 50);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-x-10');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
