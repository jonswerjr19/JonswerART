<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atelier & Galería de Arte - Estudio del Artista</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Playfair Display"', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        artCyan: '#00f0ff',
                        artBlue: '#2563eb',
                        artPurple: '#a855f7',
                        artPink: '#ec4899',
                        artDark: '#060913',
                        artCard: '#11182c',
                        artBorder: '#1f2a44',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #060913;
            color: #f3f4f6;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .art-gradient-text {
            background: linear-gradient(135deg, #00f0ff 0%, #a855f7 50%, #ec4899 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .glass-panel {
            background: rgba(17, 24, 44, 0.82);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 240, 255, 0.15);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #060913;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #1f2a44;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #00f0ff;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col custom-scrollbar select-none">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-20 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <!-- HEADER / NAVIGATION BAR -->
    <header class="sticky top-0 z-40 w-full glass-panel border-b border-cyan-900/40 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-400 via-purple-500 to-pink-500 p-[2px] transition-transform duration-300 group-hover:scale-105">
                    <div class="w-full h-full bg-artDark rounded-[10px] flex items-center justify-center">
                        <i class="fa-solid fa-palette text-cyan-400 text-lg"></i>
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="font-serif text-xl sm:text-2xl font-bold tracking-wide text-white group-hover:text-cyan-400 transition-colors">
                        ATELIER & GALERÍA
                    </span>
                    <span class="text-[10px] uppercase tracking-widest text-cyan-400 font-semibold">Obras Únicas & Encargos</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
                <a href="#galeria" class="hover:text-cyan-400 transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-images text-xs text-cyan-400"></i> Galería
                </a>
                <a href="#comisiones" class="hover:text-cyan-400 transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-comments text-xs text-purple-400"></i> Ideas & Encargos
                </a>
                <a href="#sobre-mi" class="hover:text-cyan-400 transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-user-ninja text-xs text-pink-400"></i> Sobre el Artista
                </a>
            </nav>

            <!-- Artist Mode Switcher -->
            <div class="flex items-center gap-3">
                <button id="artist-mode-btn" onclick="toggleArtistModeModal()" class="relative group px-4 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2 border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 hover:bg-cyan-400 hover:text-gray-950 shadow-lg shadow-cyan-500/10">
                    <i id="artist-status-icon" class="fa-solid fa-lock text-sm"></i>
                    <span id="artist-status-text">Modo Artista</span>
                </button>
                
                <!-- Mobile Navigation Menu Toggle -->
                <button onclick="toggleMobileMenu()" class="md:hidden text-gray-300 hover:text-white p-2">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Drawer Menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-cyan-900/50 bg-artDark/95 backdrop-blur-xl px-6 py-4 space-y-3">
            <a href="#galeria" onclick="toggleMobileMenu()" class="block py-2 text-gray-200 hover:text-cyan-400"><i class="fa-solid fa-images mr-2"></i> Galería</a>
            <a href="#comisiones" onclick="toggleMobileMenu()" class="block py-2 text-gray-200 hover:text-cyan-400"><i class="fa-solid fa-comments mr-2"></i> Ideas & Encargos</a>
            <a href="#sobre-mi" onclick="toggleMobileMenu()" class="block py-2 text-gray-200 hover:text-cyan-400"><i class="fa-solid fa-user-ninja mr-2"></i> Sobre el Artista</a>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative overflow-hidden py-16 lg:py-24 border-b border-cyan-900/30">
        <!-- Background Ambient Cyber Glows -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-cyan-500/15 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute bottom-10 right-10 w-80 h-80 bg-pink-500/15 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute top-10 left-10 w-80 h-80 bg-purple-600/15 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-artBorder/80 border border-cyan-500/30 text-cyan-300 text-xs font-semibold uppercase tracking-widest mb-6">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                Portafolio Oficial & Taller Creativo
            </div>

            <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">
                Transformando visiones en <br class="hidden sm:inline" />
                <span class="art-gradient-text">Obras de Arte Perdurables</span>
            </h1>

            <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg mb-10 leading-relaxed">
                Explora mis creaciones exclusivas en lienzo, escultura, retratos personalizados y diseño de tatuajes. Formaliza tu idea original enviando tus fotos de referencia.
            </p>

            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="#galeria" class="px-8 py-3.5 rounded-xl bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 hover:opacity-90 text-gray-950 font-bold text-sm tracking-wide shadow-lg shadow-cyan-500/25 transition-all duration-300 hover:scale-[1.02]">
                    <i class="fa-solid fa-compass mr-2"></i> Explorar Galería
                </a>
                <a href="#comisiones" class="px-8 py-3.5 rounded-xl bg-artCard border border-cyan-500/30 hover:border-pink-500 text-white font-semibold text-sm tracking-wide transition-all duration-300 hover:bg-artBorder flex items-center gap-2">
                    <i class="fa-solid fa-lightbulb text-pink-400"></i> Encargar Idea Personalizada
                </a>
            </div>

            <!-- Stats Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto mt-16 pt-12 border-t border-cyan-900/40">
                <div class="p-4 rounded-2xl glass-panel">
                    <div class="font-serif text-3xl font-bold text-cyan-400" id="stat-total-art">0</div>
                    <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">Obras en Galería</div>
                </div>
                <div class="p-4 rounded-2xl glass-panel">
                    <div class="font-serif text-3xl font-bold text-pink-400" id="stat-total-likes">0</div>
                    <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">Apreciaciones / Likes</div>
                </div>
                <div class="p-4 rounded-2xl glass-panel">
                    <div class="font-serif text-3xl font-bold text-purple-400" id="stat-categories">4</div>
                    <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">Disciplinas Artísticas</div>
                </div>
                <div class="p-4 rounded-2xl glass-panel">
                    <div class="font-serif text-3xl font-bold text-blue-400" id="stat-commissions">0</div>
                    <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">Proyectos en Consulta</div>
                </div>
            </div>
        </div>
    </section>

    <!-- GALLERY SECTION -->
    <section id="galeria" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
            <div>
                <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-2">Galería de Exposición</h2>
                <p class="text-gray-400 text-sm">Filtra por disciplina artística para apreciar cada trabajo detalladamente.</p>
            </div>

            <!-- Artist Upload Trigger -->
            <div class="flex items-center gap-3">
                <button onclick="openUploadModal()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 via-pink-600 to-cyan-500 hover:opacity-90 text-white font-semibold text-xs tracking-wider uppercase transition-all duration-300 shadow-md flex items-center gap-2">
                    <i class="fa-solid fa-plus-circle text-base"></i> Subir Nueva Obra
                </button>
            </div>
        </div>

        <!-- Filter Categories -->
        <div class="flex items-center gap-2 overflow-x-auto pb-4 custom-scrollbar mb-8">
            <button onclick="filterGallery('all')" class="cat-btn active px-5 py-2.5 rounded-xl text-xs font-bold tracking-wider uppercase transition-all whitespace-nowrap bg-cyan-400 text-gray-950 shadow-lg shadow-cyan-500/20" data-cat="all">
                <i class="fa-solid fa-border-all mr-1.5"></i> Todas Obras
            </button>
            <button onclick="filterGallery('Pinturas')" class="cat-btn px-5 py-2.5 rounded-xl text-xs font-bold tracking-wider uppercase transition-all whitespace-nowrap bg-artCard text-gray-300 hover:text-white border border-gray-800 hover:border-cyan-500/50" data-cat="Pinturas">
                <i class="fa-solid fa-palette mr-1.5 text-cyan-400"></i> Pinturas
            </button>
            <button onclick="filterGallery('Retratos')" class="cat-btn px-5 py-2.5 rounded-xl text-xs font-bold tracking-wider uppercase transition-all whitespace-nowrap bg-artCard text-gray-300 hover:text-white border border-gray-800 hover:border-cyan-500/50" data-cat="Retratos">
                <i class="fa-solid fa-user-astronaut mr-1.5 text-pink-400"></i> Retratos
            </button>
            <button onclick="filterGallery('Esculturas')" class="cat-btn px-5 py-2.5 rounded-xl text-xs font-bold tracking-wider uppercase transition-all whitespace-nowrap bg-artCard text-gray-300 hover:text-white border border-gray-800 hover:border-cyan-500/50" data-cat="Esculturas">
                <i class="fa-solid fa-cubes mr-1.5 text-purple-400"></i> Esculturas
            </button>
            <button onclick="filterGallery('Tatuajes')" class="cat-btn px-5 py-2.5 rounded-xl text-xs font-bold tracking-wider uppercase transition-all whitespace-nowrap bg-artCard text-gray-300 hover:text-white border border-gray-800 hover:border-cyan-500/50" data-cat="Tatuajes">
                <i class="fa-solid fa-pen-nib mr-1.5 text-blue-400"></i> Tatuajes
            </button>
        </div>

        <!-- Gallery Grid -->
        <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Dynamic Artwork Cards Inserted Here via JS -->
        </div>

        <!-- Empty State -->
        <div id="gallery-empty" class="hidden text-center py-20 bg-artCard/30 rounded-3xl border border-dashed border-cyan-900/40">
            <i class="fa-solid fa-box-open text-5xl text-gray-600 mb-4"></i>
            <h3 class="text-xl font-bold text-gray-300">No hay obras registradas en esta categoría</h3>
            <p class="text-gray-500 text-sm mt-1">Sube una nueva creación como artista o selecciona otra categoría.</p>
        </div>
    </section>

    <!-- CLIENT IDEAS & COMMISSION CHAT SECTION -->
    <section id="comisiones" class="py-16 border-t border-cyan-900/40 bg-slate-950/60 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="text-purple-400 text-xs font-bold uppercase tracking-widest">Atelier Interactivo</span>
                <h2 class="font-serif text-3xl sm:text-5xl font-bold text-white mt-1 mb-4">Mesa de Ideas & Comisiones</h2>
                <p class="text-gray-400 text-sm sm:text-base">
                    ¿Tienes una idea para una pintura, retrato, escultura o tatuaje exclusivo? Adjunta tus fotos de referencia, escribe tu consulta y dialogaremos directamente en el chat para hacerla realidad.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Left: Commission Request Form -->
                <div class="lg:col-span-5 glass-panel p-6 sm:p-8 rounded-3xl border border-cyan-900/40 flex flex-col justify-between">
                    <div>
                        <h3 class="font-serif text-2xl font-bold text-white mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-paper-plane text-cyan-400 text-xl"></i> Crear Nueva Consulta
                        </h3>
                        <p class="text-xs text-gray-400 mb-6">Completa tus datos e imágenes para iniciar la propuesta con el artista.</p>

                        <form id="commission-form" onsubmit="handleCommissionSubmit(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold uppercase text-gray-300 mb-1">Tu Nombre / Pseudónimo</label>
                                <input type="text" id="client-name" required placeholder="Ej: Valentina Morales" class="w-full bg-artDark/80 border border-artBorder rounded-xl px-4 py-3 text-sm text-gray-200 focus:outline-none focus:border-cyan-400">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase text-gray-300 mb-1">Tipo de Obra Requerida</label>
                                <select id="client-type" required class="w-full bg-artDark/80 border border-artBorder rounded-xl px-4 py-3 text-sm text-gray-200 focus:outline-none focus:border-cyan-400">
                                    <option value="Pinturas">🖼️ Pintura en Lienzo / Acrílico / Óleo</option>
                                    <option value="Retratos">👤 Retrato Personalizado</option>
                                    <option value="Esculturas">🗿 Escultura / Modelo 3D</option>
                                    <option value="Tatuajes">✒️ Diseño de Tatuaje Exclusivo</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase text-gray-300 mb-1">Foto o Referencia Visual</label>
                                <div class="relative border-2 border-dashed border-artBorder hover:border-cyan-400 rounded-xl p-4 text-center cursor-pointer bg-artDark/40 transition-colors">
                                    <input type="file" id="client-image-file" accept="image/*" onchange="previewCommissionImage(event)" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                                    <div id="commission-upload-prompt" class="space-y-1">
                                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-cyan-400"></i>
                                        <p class="text-xs text-gray-300 font-medium">Haz clic o arrastra tu fotografía aquí</p>
                                        <p class="text-[10px] text-gray-500">PNG, JPG o WEBP (Soporta vistas previas)</p>
                                    </div>
                                    <div id="commission-image-preview" class="hidden flex flex-col items-center gap-2">
                                        <img src="" id="comm-preview-img" class="h-28 rounded-lg object-cover border border-cyan-400/40">
                                        <span class="text-[10px] text-cyan-400">Cambiar imagen</span>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase text-gray-300 mb-1">Descripción de la Idea</label>
                                <textarea id="client-msg" required rows="3" placeholder="Describe los colores, dimensiones, historia o detalles particulares que imaginas..." class="w-full bg-artDark/80 border border-artBorder rounded-xl px-4 py-3 text-sm text-gray-200 focus:outline-none focus:border-cyan-400 custom-scrollbar"></textarea>
                            </div>

                            <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500 hover:opacity-90 font-bold text-gray-950 text-xs uppercase tracking-wider shadow-lg transition-transform active:scale-95">
                                <i class="fa-solid fa-comments mr-2"></i> Iniciar Consulta & Chat
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Right: Active Consultations & Chat Threads -->
                <div class="lg:col-span-7 glass-panel p-6 sm:p-8 rounded-3xl border border-cyan-900/40 flex flex-col h-[650px]">
                    <div class="flex items-center justify-between pb-4 border-b border-artBorder">
                        <div>
                            <h3 class="font-serif text-xl font-bold text-white">Consultas & Conversaciones en Vivo</h3>
                            <p class="text-xs text-gray-400">Haz clic en una consulta para ver las fotos adjuntas e interactuar en el chat.</p>
                        </div>
                        <span id="comm-count-badge" class="px-3 py-1 rounded-full bg-purple-500/20 border border-purple-500/40 text-purple-300 text-xs font-bold">
                            0 solicitudes
                        </span>
                    </div>

                    <!-- Main Chat Split View -->
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 flex-1 mt-4 overflow-hidden">
                        <!-- Consultations List Sidebar -->
                        <div id="consultation-list" class="md:col-span-5 space-y-2 overflow-y-auto custom-scrollbar pr-1 border-r border-artBorder max-h-[220px] md:max-h-full">
                            <!-- Items inserted dynamically via JS -->
                        </div>

                        <!-- Active Conversation Area -->
                        <div id="chat-active-area" class="md:col-span-7 flex flex-col justify-between bg-artDark/60 rounded-2xl p-4 border border-artBorder">
                            <!-- Selected consultation state rendered here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT THE ARTIST SECTION -->
    <section id="sobre-mi" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass-panel rounded-3xl p-8 lg:p-12 border border-cyan-900/40 relative overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-4 relative group">
                    <div class="w-full h-80 sm:h-96 rounded-2xl overflow-hidden border-2 border-cyan-500/30 shadow-2xl relative">
                        <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=800&q=80" alt="El Artista" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-artDark via-transparent to-transparent"></div>
                    </div>
                    <div class="absolute bottom-4 left-4 right-4 p-4 glass-panel rounded-xl border border-cyan-500/20 text-center">
                        <p class="font-serif font-bold text-cyan-400">Artista Plástico & Tatuador</p>
                        <p class="text-[11px] text-gray-400 uppercase tracking-widest mt-0.5">Especialista en Realismo & Arte Ciber-Figurativo</p>
                    </div>
                </div>

                <div class="lg:col-span-8 space-y-4">
                    <span class="px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/30 text-pink-300 text-xs font-bold uppercase tracking-wider">Filosofía Artística</span>
                    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white">"Cada obra es una conversación entre la imaginación y la técnica."</h2>
                    <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
                        Bienvenido a mi espacio personal. Con más de una década perfeccionando las artes visuales, me dedico a crear piezas únicas en óleo, acrílico, escultura en variados medios y piezas corporales (tatuajes de alta precisión). Este portal fue diseñado para conectar directamente contigo: desde la visualización de mis últimas obras hasta el diseño colaborativo de tu próximo encargo.
                    </p>

                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-artBorder">
                        <div>
                            <p class="text-xs text-gray-500 uppercase font-semibold">Técnicas</p>
                            <p class="text-sm font-medium text-cyan-300 mt-0.5">Óleo, Mármol, Black & Grey</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 uppercase font-semibold">Ubicación</p>
                            <p class="text-sm font-medium text-cyan-300 mt-0.5">Estudio Central & Galería</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 uppercase font-semibold">Garantía</p>
                            <p class="text-sm font-medium text-cyan-300 mt-0.5">Piezas Únicas Certificadas</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="mt-auto border-t border-cyan-900/40 bg-slate-950 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-palette text-cyan-400"></i>
                <span class="font-serif font-bold text-white text-sm">Atelier & Galería de Arte</span>
                <span class="text-xs text-gray-500">© 2026 Todos los derechos reservados.</span>
            </div>
            <div class="flex items-center gap-6 text-gray-400 text-sm">
                <a href="#galeria" class="hover:text-cyan-400 transition-colors">Galería</a>
                <a href="#comisiones" class="hover:text-cyan-400 transition-colors">Encargos</a>
                <a href="#" onclick="toggleArtistModeModal(); return false;" class="text-cyan-400/80 hover:text-cyan-300 font-semibold"><i class="fa-solid fa-key text-xs mr-1"></i> Acceso Artista</a>
            </div>
        </div>
    </footer>

    <!-- LIGHTBOX / ARTWORK DETAIL MODAL -->
    <div id="artwork-modal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 overflow-y-auto">
        <div class="relative max-w-5xl w-full bg-artCard rounded-3xl border border-cyan-900/40 shadow-2xl overflow-hidden my-auto max-h-[90vh] flex flex-col lg:flex-row">
            
            <!-- Close Button -->
